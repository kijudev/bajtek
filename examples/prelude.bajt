(module prelude (
    (type u8  (bytes 1) (#native unsigned))
    (type u16 (bytes 2) (#native unsigned))
    (type u32 (bytes 4) (#native unsigned))
    (type u64 (bytes 8) (#native unsigned))

    (type s8  (bytes 1) (#native signed))
    (type s16 (bytes 2) (#native signed))
    (type s32 (bytes 4) (#native signed))
    (type s64 (bytes 8) (#native signed))

    (type f32 (bytes 4) (#native float))
    (type f64 (bytes 8) (#native float))

    (type bool (bytes 1) (#native bool))
    (type char (bytes 1) (#native char))
))
